            "set_sensitive": null,
            "set_wo": null,
            "set_wo_revision": null,
            "skip_crds": false,
            "status": "deployed",
            "timeout": 300,
            "values": [
              "server:\r\n  service:\r\n    type: LoadBalancer\r\n    port: 443"
            ],
            "verify": false,
